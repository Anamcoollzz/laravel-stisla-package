{
    "name": "anamcoollzz/laravel-stisla-package",
    "description": "Publishable Laravel Stisla admin panel, auth, RBAC, and modular app starter package.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "^3.1",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "maatwebsite/excel": "^4.0 || ^3.1",
        "mews/captcha": "^3.5",
        "spatie/laravel-permission": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "LaravelStisla\\Stisla\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelStisla\\Stisla\\StislaServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
